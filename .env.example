APP_NAME="Mecabite API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Reconocimiento (API y CLI `vision`). Reinicia el servidor o la CLI para aplicar cambios.
# Milisegundos que hay que sostener una seña estática para confirmarla. RF-06 pide 1000;
# con menos se confirman formas intermedias de las dinámicas (la I al inicio de la J).
# La API lo reporta a la app como hold_time_ms en /catalog/signs.
VISION_HOLD_MS=1000
# Confianza mínima del modelo estático para contar un cuadro (0 a 1).
VISION_CONFIDENCE_THRESHOLD=0.65
# Ventana de votos del modelo estático en milisegundos (400 = 12 cuadros a 30 fps).
VISION_VOTE_MS=400
# Tolerancia en milisegundos: si la seña se pierde menos que esto (la mano se movió un poco),
# el tiempo sostenido no se reinicia.
VISION_GRACE_MS=300
# Práctica por API: otra seña debe verse este tiempo antes de avisar "Revisa la forma de tu
# mano". Solo es el aviso; un intento fallido sigue necesitando VISION_HOLD_MS.
VISION_WRONG_SIGN_MS=500

# Guante BLE (receptor ESP32). La API lo lee desde la laptop y lo junta con cada observación.
GLOVE_DEVICE_NAME=GuanteLSM
GLOVE_CHARACTERISTIC_UUID=beb5483e-36e1-4688-b7f5-ea07361b26a8
# true: la API se conecta al guante al arrancar (en la demo). false: solo cámara.
GLOVE_LIVE=false
# true: sin lecturas recientes del guante la práctica no evalúa y responde `disconnected`.
GLOVE_REQUIRED=false
# Un guante por mano: cada paquete trae "emisor": 1 o 2. Se corrige con el guante de la mano que
# la persona eligió en la app (derecha si no eligió); el de la otra se reporta como other_glove.
GLOVE_RIGHT_EMITTER=1
GLOVE_LEFT_EMITTER=2
# Lecturas más viejas que esto (ms) cuentan como guante desconectado.
GLOVE_MAX_AGE_MS=500
# Grados que la inclinación puede alejarse de la referencia (glove_reference.json).
GLOVE_TILT_TOLERANCE_DEG=30
# false: las correcciones que ve la cámara (dedos de la C, pulgar, palma, hacia dónde apuntan
# los dedos) solo se muestran y no hacen fallar el intento. Úsalo si la cámara rechaza señas bien
# hechas; ojo: la forma de la C solo la revisa la cámara.
FEEDBACK_CAMERA_BLOCKS=true
