APP_NAME="Mecabite API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Reconocimiento (API y CLI `vision`). Reinicia el servidor o la CLI para aplicar cambios.
# Milisegundos que hay que sostener una seña estática para confirmarla. RF-06 pide 1000;
# con menos se confirman formas intermedias de las dinámicas (la I al inicio de la J).
# La API lo reporta a la app como hold_time_ms en /catalog/signs.
VISION_HOLD_MS=1000
# Confianza mínima del modelo estático para contar un cuadro (0 a 1).
VISION_CONFIDENCE_THRESHOLD=0.65
# Ventana de votos del modelo estático en milisegundos (400 = 12 cuadros a 30 fps).
VISION_VOTE_MS=400
# Tolerancia en milisegundos: si la seña se pierde menos que esto (la mano se movió un poco),
# el tiempo sostenido no se reinicia.
VISION_GRACE_MS=300
# Práctica por API: otra seña debe verse este tiempo antes de avisar "Revisa la forma de tu
# mano". Solo es el aviso; un intento fallido sigue necesitando VISION_HOLD_MS.
VISION_WRONG_SIGN_MS=500
